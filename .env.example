POSTGRES_DB=verifipay_db
POSTGRES_USER=verifipay
POSTGRES_PASSWORD=

DB_URL=jdbc:postgresql://postgres:5432/verifipay_db
DB_USERNAME=verifipay
DB_PASSWORD=

JWT_SECRET=
JWT_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=30
# JVM container-aware memory sizing. Keep this below the backend's 2 GB Compose limit.
JAVA_TOOL_OPTIONS=-XX:InitialRAMPercentage=25.0 -XX:MaxRAMPercentage=70.0
CORS_ALLOWED_ORIGINS=http://localhost:4200

PLATFORM_BOOTSTRAP_ENABLED=false
PLATFORM_BOOTSTRAP_EMAIL=
PLATFORM_BOOTSTRAP_NAME=
PLATFORM_BOOTSTRAP_PASSWORD=
BILLING_MANUAL_ENABLED=false
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false
